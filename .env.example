# PostgreSQL connection string.
# Used by the app (src/db) at runtime and by drizzle-kit (generate/migrate/push).
# Copy this file to `.env` and adjust the credentials for your database.
#
# Supabase example (use the DIRECT connection string, port 5432, with sslmode):
# DATABASE_URL=postgresql://postgres:<your-db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
